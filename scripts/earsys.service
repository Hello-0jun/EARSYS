[Unit]
Description=EARSYS - EAR-based drowsiness detection system
Documentation=https://github.com/WhiPaper/EARSYS
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/opt/earsys

EnvironmentFile=-/etc/earsys.env
Environment="EARSYS_LOG_LEVEL=INFO"
Environment="EARSYS_EAR_THRESHOLD=0.23"
Environment="EARSYS_CLOSED_FRAMES=20"

ExecStart=/opt/earsys/earsys

Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=earsys

# Restart up to 5 times on abnormal exit (within 10 minutes)
StartLimitInterval=600
StartLimitBurst=5

# Harden security
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
